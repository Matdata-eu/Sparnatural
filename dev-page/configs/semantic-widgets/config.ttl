# Demo Sparnatural SHACL configuration for the OWL-Time, GeoSPARQL and QUDT
# widgets. Goes with data.ttl in the same folder.
#
# Each property shape only points at the intermediate node (time:TemporalEntity,
# gsp:Geometry, qudt:QuantityValue). The widget follows the value path to the
# literal by itself. No NodeShape is declared for those intermediate classes.
#
# The terms marked "proposed" do not exist in sparnatural-config-core yet;
# they are introduced by the semantic widgets work (see README.md).

@prefix this: <https://example.org/sparnatural-test/config/> .
@prefix ex: <https://example.org/sparnatural-test/> .
@prefix core: <http://data.sparna.fr/ontologies/sparnatural-config-core#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix volipi: <http://data.sparna.fr/ontologies/volipi#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix gsp: <http://www.opengis.net/ont/geosparql#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .

<https://example.org/sparnatural-test/config> a owl:Ontology ;
  rdfs:label "Sparnatural semantic widgets demo"@en .


# ---------------------------------------------------------------
# Event: OWL-Time
# ---------------------------------------------------------------

this:Event a sh:NodeShape ;
  sh:order 1 ;
  sh:targetClass ex:Event ;
  rdfs:label "Event"@en, "Evénement"@fr ;
  volipi:iconName "fa-solid fa-calendar-day" ;
  sh:property this:Event_label, this:Event_tookPlace .

this:Event_label a sh:PropertyShape ;
  sh:order 1 ;
  sh:path rdfs:label ;
  sh:name "name"@en, "nom"@fr ;
  sh:datatype rdf:langString ;
  dash:searchWidget core:SearchProperty .

# Instants and intervals alike. Auto-detected from sh:class: the
# dash:searchWidget line below is optional and only shows the explicit form.
this:Event_tookPlace a sh:PropertyShape ;
  sh:order 2 ;
  sh:path ex:tookPlace ;
  sh:name "took place"@en, "a eu lieu"@fr ;
  sh:class time:TemporalEntity ;
  dash:searchWidget core:OwlTimeProperty .     # proposed


# ---------------------------------------------------------------
# Place: GeoSPARQL
# ---------------------------------------------------------------

this:Place a sh:NodeShape ;
  sh:order 2 ;
  sh:targetClass ex:Place ;
  rdfs:label "Place"@en, "Lieu"@fr ;
  volipi:iconName "fa-solid fa-location-dot" ;
  sh:property this:Place_label, this:Place_hasGeometry .

this:Place_label a sh:PropertyShape ;
  sh:order 1 ;
  sh:path rdfs:label ;
  sh:name "name"@en, "nom"@fr ;
  sh:datatype rdf:langString ;
  dash:searchWidget core:SearchProperty .

# Auto-detected from sh:class gsp:Geometry, no widget declared.
this:Place_hasGeometry a sh:PropertyShape ;
  sh:order 2 ;
  sh:path gsp:hasGeometry ;
  sh:name "has geometry"@en, "a pour géométrie"@fr ;
  sh:class gsp:Geometry .


# ---------------------------------------------------------------
# Sample: QUDT
# ---------------------------------------------------------------

this:Sample a sh:NodeShape ;
  sh:order 3 ;
  sh:targetClass ex:Sample ;
  rdfs:label "Sample"@en, "Echantillon"@fr ;
  volipi:iconName "fa-solid fa-flask" ;
  sh:property this:Sample_label, this:Sample_mass, this:Sample_storageTemperature .

this:Sample_label a sh:PropertyShape ;
  sh:order 1 ;
  sh:path rdfs:label ;
  sh:name "name"@en, "nom"@fr ;
  sh:datatype rdf:langString ;
  dash:searchWidget core:SearchProperty .

# Unit list limited to quantitykind:Mass, kg preselected, conversion
# factors from the unit table bundled with Sparnatural.
this:Sample_mass a sh:PropertyShape ;
  sh:order 2 ;
  sh:path ex:mass ;
  sh:name "mass"@en, "masse"@fr ;
  sh:class qudt:QuantityValue ;
  qudt:hasQuantityKind quantitykind:Mass ;
  core:defaultUnit unit:KiloGM ;               # proposed
  core:unitConversion core:ClientSide .        # proposed

# Conversion factors read from the QUDT units graph loaded in the endpoint
# (load the QUDT unit vocabulary alongside data.ttl to test this mode).
this:Sample_storageTemperature a sh:PropertyShape ;
  sh:order 3 ;
  sh:path ex:storageTemperature ;
  sh:name "storage temperature"@en, "température de stockage"@fr ;
  sh:class qudt:QuantityValue ;
  qudt:hasQuantityKind quantitykind:Temperature ;
  core:defaultUnit unit:DEG_C ;                # proposed
  core:unitConversion core:Endpoint .          # proposed
